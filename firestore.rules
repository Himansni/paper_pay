rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function memberPath(businessId, uid) {
      return /databases/$(database)/documents/businesses/$(businessId)/members/$(uid);
    }

    function memberData(businessId) {
      return get(memberPath(businessId, request.auth.uid)).data;
    }

    function activeMember(businessId) {
      return signedIn()
        && exists(memberPath(businessId, request.auth.uid))
        && memberData(businessId).status == 'active'
        && memberData(businessId).businessId == businessId;
    }

    function head(businessId) {
      return activeMember(businessId) && memberData(businessId).role == 'head';
    }

    function permission(businessId, name) {
      return activeMember(businessId)
        && memberData(businessId).permissions is list
        && memberData(businessId).permissions.hasAny([name]);
    }

    function customerPath(businessId, customerId) {
      return /databases/$(database)/documents/businesses/$(businessId)/customers/$(customerId);
    }

    function areaPath(businessId, areaId) {
      return /databases/$(database)/documents/businesses/$(businessId)/areas/$(areaId);
    }

    function auditPath(businessId, auditId) {
      return /databases/$(database)/documents/businesses/$(businessId)/auditRecords/$(auditId);
    }

    function canReadCustomerData(businessId, data) {
      return activeMember(businessId)
        && data.businessId == businessId
        && (head(businessId) || data.assignedEmployeeId == request.auth.uid);
    }

    function canReadCustomer(businessId, customerId) {
      return canReadCustomerData(
        businessId,
        get(customerPath(businessId, customerId)).data
      );
    }

    function activeArea(businessId, areaId) {
      return areaId is string
        && areaId.size() > 0
        && exists(areaPath(businessId, areaId))
        && get(areaPath(businessId, areaId)).data.businessId == businessId
        && get(areaPath(businessId, areaId)).data.status == 'active';
    }

    function validActiveEmployeeForArea(businessId, employeeId, areaId) {
      let employee = get(memberPath(businessId, employeeId)).data;
      return employeeId is string
        && exists(memberPath(businessId, employeeId))
        && employee.businessId == businessId
        && employee.uid == employeeId
        && employee.role == 'employee'
        && employee.status == 'active'
        && employee.areaIds is list
        && employee.areaIds.hasAny([areaId]);
    }

    function activeEmployeeForArea(businessId, employeeId, areaId) {
      return employeeId == ''
        || validActiveEmployeeForArea(businessId, employeeId, areaId);
    }

    function validCustomerCoordinates(data) {
      return (
          data.locationConsent == false
          && data.coordinates == null
        ) || (
          data.locationConsent == true
          && data.coordinates is map
          && data.coordinates.keys().hasAll(['latitude', 'longitude'])
          && data.coordinates.keys().hasOnly(['latitude', 'longitude'])
          && data.coordinates.latitude is number
          && data.coordinates.latitude >= -90
          && data.coordinates.latitude <= 90
          && data.coordinates.longitude is number
          && data.coordinates.longitude >= -180
          && data.coordinates.longitude <= 180
        );
    }

    function validCustomerPreferences(data) {
      return data.deliveryPreferences is map
        && data.deliveryPreferences.keys().hasAll(['placement'])
        && data.deliveryPreferences.keys().hasOnly(['placement'])
        && data.deliveryPreferences.placement in [
          'doorstep', 'handToCustomer', 'reception', 'collectionPoint'
        ]
        && data.billingPreferences is map
        && data.billingPreferences.keys().hasAll(['cycle'])
        && data.billingPreferences.keys().hasOnly(['cycle'])
        && data.billingPreferences.cycle in [
          'monthly', 'fortnightly', 'weekly'
        ];
    }

    function validCustomerShape(businessId, customerId, data) {
      return data.keys().hasOnly([
          'businessId', 'customerCode', 'name', 'searchName', 'phone',
          'searchPhone', 'alternatePhone', 'address', 'areaId', 'landmark',
          'searchLandmark', 'searchTokens', 'houseNumber', 'buildingInfo',
          'locationNotes', 'locationConsent', 'coordinates',
          'assignedEmployeeId', 'status', 'subscriptionStatus',
          'deliveryPreferences', 'billingPreferences', 'openingBalancePaise',
          'notes', 'createdBy', 'updatedBy', 'lastAuditId', 'createdAt',
          'updatedAt'
        ])
        && data.businessId == businessId
        && data.customerCode == customerId
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 100
        && data.searchName is string
        && data.searchName.size() >= 2
        && data.phone is string
        && data.phone.size() >= 7
        && data.phone.size() <= 24
        && data.searchPhone is string
        && data.searchPhone.size() >= 7
        && data.searchPhone.size() <= 15
        && data.alternatePhone is string
        && data.alternatePhone.size() <= 24
        && data.address is string
        && data.address.size() >= 5
        && data.address.size() <= 300
        && data.areaId is string
        && data.landmark is string
        && data.landmark.size() >= 2
        && data.landmark.size() <= 120
        && data.searchLandmark is string
        && data.searchTokens is list
        && data.searchTokens.size() <= 300
        && data.houseNumber is string
        && data.houseNumber.size() <= 80
        && data.buildingInfo is string
        && data.buildingInfo.size() <= 120
        && data.locationNotes is string
        && data.locationNotes.size() <= 300
        && data.locationConsent is bool
        && data.assignedEmployeeId is string
        && data.status in ['active', 'archived']
        && data.subscriptionStatus == 'notConfigured'
        && data.openingBalancePaise is int
        && data.openingBalancePaise >= 0
        && data.openingBalancePaise <= 100000000
        && data.notes is string
        && data.notes.size() <= 500
        && data.createdBy is string
        && data.updatedBy is string
        && data.lastAuditId is string
        && data.lastAuditId.size() > 0
        && validCustomerCoordinates(data)
        && validCustomerPreferences(data);
    }

    function validCustomerAuditAfter(businessId, customerId, auditId, action) {
      let audit = getAfter(auditPath(businessId, auditId)).data;
      return existsAfter(auditPath(businessId, auditId))
        && audit.businessId == businessId
        && audit.actorId == request.auth.uid
        && audit.entityType == 'customer'
        && audit.entityId == customerId
        && audit.action == action
        && audit.createdAt == request.time;
    }

    function validCustomerCreateAuditAfter(businessId, customerId, auditId) {
      let audit = getAfter(auditPath(businessId, auditId)).data;
      return validCustomerAuditAfter(
          businessId,
          customerId,
          auditId,
          'customerCreated'
        )
        && audit.employeeId == request.resource.data.assignedEmployeeId
        && audit.areaId == request.resource.data.areaId
        && audit.openingBalancePaise == request.resource.data.openingBalancePaise;
    }

    function validCustomerProfileAuditAfter(businessId, customerId, auditId) {
      let audit = getAfter(auditPath(businessId, auditId)).data;
      return validCustomerAuditAfter(
          businessId,
          customerId,
          auditId,
          'customerUpdated'
        )
        && audit.changedFields is list
        && audit.changedFields.size() > 0
        && audit.changedFields.hasOnly([
          'name', 'searchName', 'phone', 'searchPhone', 'alternatePhone',
          'address', 'landmark', 'searchLandmark', 'searchTokens',
          'houseNumber', 'buildingInfo', 'locationNotes', 'locationConsent',
          'coordinates', 'deliveryPreferences', 'billingPreferences', 'notes'
        ]);
    }

    function validCustomerAssignmentAuditAfter(
      businessId,
      customerId,
      auditId
    ) {
      let audit = getAfter(auditPath(businessId, auditId)).data;
      return validCustomerAuditAfter(
          businessId,
          customerId,
          auditId,
          'customerAssignmentUpdated'
        )
        && audit.previousEmployeeId == resource.data.assignedEmployeeId
        && audit.employeeId == request.resource.data.assignedEmployeeId
        && audit.previousAreaId == resource.data.areaId
        && audit.areaId == request.resource.data.areaId;
    }

    function customerReferencesAuditAfter(businessId, customerId, auditId) {
      let customer = getAfter(customerPath(businessId, customerId)).data;
      return existsAfter(customerPath(businessId, customerId))
        && customer.businessId == businessId
        && customer.lastAuditId == auditId
        && customer.updatedBy == request.auth.uid
        && customer.updatedAt == request.time;
    }

    function validCustomerProfileUpdate(businessId, customerId) {
      return resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'searchName', 'phone', 'searchPhone', 'alternatePhone',
          'address', 'landmark', 'searchLandmark', 'searchTokens',
          'houseNumber', 'buildingInfo', 'locationNotes', 'locationConsent',
          'coordinates', 'deliveryPreferences', 'billingPreferences', 'notes',
          'updatedBy', 'lastAuditId', 'updatedAt'
        ])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastAuditId != resource.data.lastAuditId
        && validCustomerProfileAuditAfter(
          businessId,
          customerId,
          request.resource.data.lastAuditId
        );
    }

    function validCustomerStatusUpdate(businessId, customerId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedBy', 'lastAuditId', 'updatedAt'
        ])
        && request.resource.data.status != resource.data.status
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastAuditId != resource.data.lastAuditId
        && (
          (
            request.resource.data.status == 'archived'
            && validCustomerAuditAfter(
              businessId,
              customerId,
              request.resource.data.lastAuditId,
              'customerArchived'
            )
          ) || (
            request.resource.data.status == 'active'
            && validCustomerAuditAfter(
              businessId,
              customerId,
              request.resource.data.lastAuditId,
              'customerReactivated'
            )
          )
        );
    }

    function validCustomerAssignmentUpdate(businessId, customerId) {
      return resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'areaId', 'assignedEmployeeId', 'updatedBy', 'lastAuditId',
          'updatedAt'
        ])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastAuditId != resource.data.lastAuditId
        && activeArea(businessId, request.resource.data.areaId)
        && activeEmployeeForArea(
          businessId,
          request.resource.data.assignedEmployeeId,
          request.resource.data.areaId
        )
        && validCustomerAssignmentAuditAfter(
          businessId,
          customerId,
          request.resource.data.lastAuditId
        );
    }

    function acceptedInviteAfter(businessId, invitationId) {
      let invite = getAfter(
        /databases/$(database)/documents/businesses/$(businessId)/invitations/$(invitationId)
      ).data;
      return invite.status == 'accepted'
        && invite.role == 'employee'
        && invite.email == request.auth.token.email
        && invite.acceptedBy == request.auth.uid;
    }

    match /userProfiles/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list: if false;

      allow create: if verifiedEmail()
        && uid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'businessId', 'role', 'status',
          'permissions', 'acceptedInviteId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'employee'
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(memberPath(request.resource.data.businessId, uid))
        && acceptedInviteAfter(
          request.resource.data.businessId,
          request.resource.data.acceptedInviteId
        );

      allow update: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'phone', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /businesses/{businessId} {
      allow read: if activeMember(businessId);
      // The first business and Head are bootstrapped through the trusted
      // Firebase Console. The mobile client can never promote itself to Head.
      allow create, delete: if false;
      allow update: if head(businessId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'address', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      match /members/{memberId} {
        // A disabled employee can read only their own membership so the app
        // can show the disabled-account gate. All other business data still
        // requires activeMember().
        allow get: if head(businessId)
          || (
            signedIn()
            && memberId == request.auth.uid
            && resource.data.businessId == businessId
          );
        allow list: if head(businessId);

        allow create: if head(businessId)
          || (
            verifiedEmail()
            && memberId == request.auth.uid
            && request.resource.data.keys().hasAll([
              'businessId', 'uid', 'email', 'displayName', 'phone', 'role',
              'status', 'permissions', 'areaIds', 'acceptedInviteId',
              'createdAt', 'updatedAt'
            ])
            && request.resource.data.businessId == businessId
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.role == 'employee'
            && request.resource.data.status == 'active'
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && acceptedInviteAfter(
              businessId,
              request.resource.data.acceptedInviteId
            )
          );

        allow update: if head(businessId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'phone', 'status', 'permissions', 'areaIds',
            'notes', 'updatedAt'
          ])
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /invitations/{invitationId} {
        allow get: if head(businessId)
          || (
            verifiedEmail()
            && resource.data.status == 'pending'
            && resource.data.email == request.auth.token.email
          );
        allow list: if head(businessId);
        allow create: if head(businessId)
          && request.resource.data.keys().hasAll([
            'businessId', 'email', 'role', 'status', 'permissions', 'areaIds',
            'createdBy', 'createdAt', 'expiresAt'
          ])
          && request.resource.data.businessId == businessId
          && request.resource.data.role == 'employee'
          && request.resource.data.status == 'pending'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt > request.time;

        allow update: if head(businessId)
          || (
            verifiedEmail()
            && resource.data.status == 'pending'
            && resource.data.role == 'employee'
            && resource.data.email == request.auth.token.email
            && resource.data.expiresAt > request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'acceptedBy', 'acceptedAt'])
            && request.resource.data.status == 'accepted'
            && request.resource.data.acceptedBy == request.auth.uid
            && request.resource.data.acceptedAt == request.time
          );
        allow delete: if head(businessId);
      }

      match /areas/{areaId} {
        allow read: if activeMember(businessId);
        allow create: if head(businessId)
          && request.resource.data.businessId == businessId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if head(businessId)
          && request.resource.data.businessId == businessId
          && request.resource.data.updatedAt == request.time;
        allow delete: if head(businessId);
      }

      match /customers/{customerId} {
        allow read: if canReadCustomerData(businessId, resource.data);
        allow create: if activeMember(businessId)
          && validCustomerShape(businessId, customerId, request.resource.data)
          && request.resource.data.status == 'active'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && activeArea(businessId, request.resource.data.areaId)
          && validCustomerCreateAuditAfter(
            businessId,
            customerId,
            request.resource.data.lastAuditId
          )
          && (
            (
              memberData(businessId).role == 'head'
              && activeEmployeeForArea(
                businessId,
                request.resource.data.assignedEmployeeId,
                request.resource.data.areaId
              )
            )
            || (
              memberData(businessId).role == 'employee'
              && memberData(businessId).permissions is list
              && memberData(businessId).permissions.hasAny(['addCustomers'])
              && request.resource.data.assignedEmployeeId == request.auth.uid
              && request.resource.data.openingBalancePaise == 0
              && memberData(businessId).areaIds is list
              && memberData(businessId).areaIds.hasAny([
                request.resource.data.areaId
              ])
            )
          );
        allow update: if validCustomerShape(
            businessId,
            customerId,
            request.resource.data
          )
          && (
            (
              head(businessId)
              && (
                validCustomerProfileUpdate(businessId, customerId)
                || validCustomerStatusUpdate(businessId, customerId)
                || validCustomerAssignmentUpdate(businessId, customerId)
              )
            ) || (
              canReadCustomerData(businessId, resource.data)
              && permission(businessId, 'editAssignedCustomers')
              && validCustomerProfileUpdate(businessId, customerId)
            )
          );
        allow delete: if false;

        match /subscriptions/{subscriptionId} {
          allow read: if canReadCustomer(businessId, customerId);
          allow create, update: if head(businessId)
            && request.resource.data.businessId == businessId
            && request.resource.data.customerId == customerId
            && request.resource.data.updatedAt == request.time;
          allow delete: if false;
        }

        match /deliveryExceptions/{exceptionId} {
          allow read: if canReadCustomer(businessId, customerId);
          allow create: if canReadCustomer(businessId, customerId)
            && (
              head(businessId)
              || permission(businessId, 'recordDeliveryExceptions')
            )
            && request.resource.data.businessId == businessId
            && request.resource.data.customerId == customerId
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }

        match /bills/{billId} {
          allow read: if canReadCustomer(businessId, customerId);
          allow create: if head(businessId)
            && request.resource.data.businessId == businessId
            && request.resource.data.customerId == customerId
            && request.resource.data.status == 'finalized'
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }

        match /payments/{paymentId} {
          allow read: if canReadCustomer(businessId, customerId);
          allow create: if canReadCustomer(businessId, customerId)
            && (
              head(businessId)
              || permission(businessId, 'recordPayments')
            )
            && request.resource.data.businessId == businessId
            && request.resource.data.customerId == customerId
            && request.resource.data.idempotencyKey == paymentId
            && request.resource.data.amountPaise is int
            && request.resource.data.amountPaise > 0
            && request.resource.data.status == 'manuallyConfirmed'
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }

        match /paymentReversals/{reversalId} {
          allow read: if canReadCustomer(businessId, customerId);
          allow create: if head(businessId)
            && request.resource.data.businessId == businessId
            && request.resource.data.customerId == customerId
            && request.resource.data.amountPaise is int
            && request.resource.data.amountPaise > 0
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }
      }

      match /newspapers/{newspaperId} {
        allow read: if activeMember(businessId);
        allow create, update: if head(businessId)
          && request.resource.data.businessId == businessId
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;

        match /priceOverrides/{dateKey} {
          allow read: if activeMember(businessId);
          allow create, update: if head(businessId)
            && request.resource.data.businessId == businessId
            && request.resource.data.newspaperId == newspaperId
            && request.resource.data.updatedAt == request.time;
          allow delete: if false;
        }
      }

      match /configuration/{documentId} {
        allow read: if activeMember(businessId);
        allow create, update: if head(businessId)
          && request.resource.data.businessId == businessId
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /auditRecords/{auditId} {
        allow read: if head(businessId);
        allow create: if activeMember(businessId)
          && request.resource.data.businessId == businessId
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (
            head(businessId)
            || (
              request.resource.data.entityType == 'customer'
              && request.resource.data.entityId is string
              && customerReferencesAuditAfter(
                businessId,
                request.resource.data.entityId,
                auditId
              )
            )
          );
        allow update, delete: if false;
      }

      match /monthlySummaries/{summaryId} {
        allow read, create, update: if head(businessId);
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
