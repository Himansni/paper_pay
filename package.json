{
  "name": "paper-route-firebase-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "seed:phase3-emulator": "node tool/seed_phase3_emulator.mjs",
    "seed:phase4-emulator": "node tool/seed_phase4_emulator.mjs",
    "seed:phase5-emulator": "node tool/seed_phase4_emulator.mjs",
    "seed:phase6-emulator": "node tool/seed_phase4_emulator.mjs",
    "seed:phase7-emulator": "node tool/seed_phase4_emulator.mjs",
    "validate:release": "node tool/validate_release_config.mjs",
    "validate:indexes": "node --test test/indexes/*.test.mjs",
    "validate:hygiene": "node tool/validate_repository_hygiene.mjs",
    "profile:phase8": "firebase emulators:exec --project demo-paper-route --only firestore \"node tool/profile_phase8_scale_emulator.mjs\"",
    "test:rules": "firebase emulators:exec --project demo-paper-route --only firestore \"node --test test/firestore/*.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.16.0"
